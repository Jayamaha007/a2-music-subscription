# config.env — Copy this file to config.env, fill in your values, then run ./setup.sh
# NEVER commit config.env — it is already gitignored.
#
# Usage:
#   cp config.env.example config.env
#   # Edit the values below
#   ./setup.sh

# ── AWS ────────────────────────────────────────────────────────────────────
# Region where all resources are created. AWS Academy Learner Lab uses us-east-1.
AWS_REGION=us-east-1

# IAM role for Lambda functions. AWS Academy only allows LabRole.
IAM_ROLE_NAME=LabRole

# ── S3 ─────────────────────────────────────────────────────────────────────
# Bucket for artist images. Must be globally unique across all AWS accounts.
# Choose something like: yourname-music-images-2026
S3_BUCKET_NAME=my-music-images-2026

# ── DynamoDB ───────────────────────────────────────────────────────────────
# Keep these defaults unless you have a reason to change them.
DYNAMODB_LOGIN_TABLE=LoginTable
DYNAMODB_MUSIC_TABLE=Music
DYNAMODB_SUBSCRIPTIONS_TABLE=Subscriptions

# ── EC2 (backend/ec2/deploy_ec2.sh) ────────────────────────────────────────
# Name of an existing EC2 key pair in your AWS account (used for SSH access).
# Create one in the AWS Console → EC2 → Key Pairs if you don't have one.
EC2_KEY_PAIR_NAME=my-key-pair

# Instance type — t2.micro is free-tier eligible and sufficient for this project.
EC2_INSTANCE_TYPE=t2.micro

# IAM instance profile attached to the EC2 instance.
# AWS Academy Learner Lab uses "LabInstanceProfile" (associated with LabRole).
EC2_INSTANCE_PROFILE=LabInstanceProfile

# HTTPS clone URL of this repository — used by the EC2 user-data to pull the code.
GITHUB_REPO_URL=https://github.com/Jayamaha007/a2-music-subscription.git

# ── ECS (backend/ecs/deploy_ecs.sh) ────────────────────────────────────────
# Names for the ECR repository, ECS cluster, and ECS service.
# Change these if you want to run multiple deployments side-by-side.
ECR_REPO_NAME=music-app
ECS_CLUSTER_NAME=music-cluster
ECS_SERVICE_NAME=music-service

# Fargate task resource allocation.
# 256 CPU / 512 MB is the minimum and is sufficient for this project.
ECS_TASK_CPU=256
ECS_TASK_MEMORY=512
